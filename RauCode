        if member == ctx.author:
            description = f"Aww, {ctx.author.mention} needs some self-love! Here's a virtual one for you! 🤗"
            if "pats" in description_template:
                description = f"{ctx.author.mention} pats themselves gently. Self-care is important! 😊"
            elif "slaps" in description_template: # Slapping self might be too negative
                description = f"{ctx.author.mention} looks like they need a hug, not a slap! 🤗"
            elif "kisses" in description_template:
                 description = f"{ctx.author.mention} gives themselves a loving kiss! 😘"

        elif member == self.bot.user:
            description = f"Aww, thank you {ctx.author.mention}! That's so sweet of you! 🥰"
            if "slaps" in description_template:
                description = f"Ouch! {ctx.author.mention}, why would you slap me? 😢"
        else:
            description = description_template.format(author=ctx.author.mention, member=member.mention)

        embed = discord.Embed(
            title=title,
            description=description,
            color=color,
            timestamp=datetime.datetime.utcnow()
        )
        if gifs: # Check if the list is not empty
            embed.set_image(url=random.choice(gifs))
        embed.set_footer(text=self.create_fun_footer(ctx), icon_url=ctx.author.avatar.url if ctx.author.avatar else None)
