    async def cog_command_error(self, ctx, error):
        title = "🚫 Command Error"
        description = "An unexpected error occurred."
        color = discord.Color.red()
        if isinstance(error, commands.MissingRequiredArgument):
            title = "🚫 Missing Argument"; description = f"Missing: `{error.param.name}`. Check help."
        elif isinstance(error, commands.BadArgument):
            title = "🚫 Bad Argument"; description = f"Invalid argument. {error}"
        elif isinstance(error, commands.CommandNotFound):
            return # Should be handled by bot's global on_command_error
        elif isinstance(error, commands.MissingPermissions):
            title = "🚫 Permission Denied"; description = "You lack permissions." + "\nRequired: " + ", ".join(error.missing_permissions)
        elif isinstance(error, commands.BotMissingPermissions):
            title = "🚫 Bot Permission Denied"; description = "I lack permissions." + "\nRequired: " + ", ".join(error.missing_permissions)
        elif isinstance(error, commands.MemberNotFound):
            title = "🚫 Member Not Found"; description = f"Member `{error.argument}` not found."
        elif isinstance(error, commands.UserNotFound):
            title = "🚫 User Not Found"; description = f"User `{error.argument}` not found."
        elif isinstance(error, commands.ChannelNotFound):
            title = "🚫 Channel Not Found"; description = f"Channel `{error.argument}` not found."
        elif isinstance(error, commands.NoPrivateMessage):
            title = "🚫 Server Only"; description = "Command not for DMs."
        else:
            description = str(error)
            print(f"Unhandled error in Moderation cog: {error.__class__.__name__} - {error}")

        embed = discord.Embed(title=title, description=description, color=color, timestamp=datetime.datetime.utcnow())
        embed.set_footer(text=f"Error in '{ctx.command}'")
        await ctx.send(embed=embed)

