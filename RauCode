    async def calc(self, ctx, *, expression: str):
        """Calculates a mathematical expression."""
        # WARNING: Using eval() is generally unsafe if the input is not strictly controlled.
        # For a public bot, consider using a safer math parsing library (e.g., numexpr, asteval).
        # Here, we'll use a very limited eval for demonstration.
        allowed_chars = "0123456789+-*/(). " # Whitelist characters
