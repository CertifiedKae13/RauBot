    # Simplified duration parser for remindme (can be expanded)
    def _parse_reminder_duration(self, time_str: str) -> tuple[int, str]:
        """Parses a common time string (e.g., 10m, 1h, 2d) into seconds and a formatted string."""
        time_str = time_str.lower()
        value = int(time_str[:-1])
        unit = time_str[-1]
        seconds = 0
        formatted_unit = ""

        if unit == 's': seconds = value; formatted_unit = "second"
        elif unit == 'm': seconds = value * 60; formatted_unit = "minute"
        elif unit == 'h': seconds = value * 60 * 60; formatted_unit = "hour"
        elif unit == 'd': seconds = value * 60 * 60 * 24; formatted_unit = "day"
        else: raise ValueError("Invalid time unit. Use 's', 'm', 'h', or 'd'.")

        if value > 1: formatted_unit += "s" # Pluralize
        return seconds, f"{value} {formatted_unit}"

    @commands.command(aliases=['remind', 'reminder'])
    async def remindme(self, ctx, time_str: str, *, message: str):
        """Sets a reminder. E.g., !remindme 10m Check the oven"""
        try:
            duration_seconds, formatted_duration_str = self._parse_reminder_duration(time_str)
            if duration_seconds <= 0:
                raise ValueError("Duration must be positive.")
            # Optional: Add a maximum duration limit (e.g., 30 days)
            if duration_seconds > 30 * 24 * 60 * 60: # Max 30 days
                 await ctx.send(embed=discord.Embed(title="⚙️ Reminder Error", description="Sorry, I can only set reminders up to 30 days in advance.", color=discord.Color.red())); return

        except ValueError as e:
            embed = discord.Embed(
                title="⚙️ Invalid Time Format",
                description=f"Please use a valid time format (e.g., `10m`, `1h`, `2d`). Error: {e}",
                color=discord.Color.orange(),
                timestamp=datetime.datetime.utcnow()
            )
            await ctx.send(embed=embed)
            return

        target_time = datetime.datetime.utcnow() + datetime.timedelta(seconds=duration_seconds)
        
        embed_set = discord.Embed(
            title="⏰ Reminder Set!",
            description=f"Okay, {ctx.author.mention}, I will remind you about: **{message}**\nIn: **{formatted_duration_str}** (at {discord.utils.format_dt(target_time, style='F')}).",
            color=discord.Color.green(),
            timestamp=datetime.datetime.utcnow()
        )
        embed_set.set_footer(text=self.create_utility_footer(ctx), icon_url=ctx.author.avatar.url if ctx.author.avatar else None)
        await ctx.send(embed=embed_set)

        await asyncio.sleep(duration_seconds)

        delivery_embed = discord.Embed(
            title="⏰ Reminder!",
            description=f"Hi {ctx.author.mention}, you asked me to remind you about: **{message}**",
            color=discord.Color.blue(),
            timestamp=datetime.datetime.utcnow() # Time of delivery
        )
        delivery_embed.add_field(name="Originally Set At", value=discord.utils.format_dt(target_time - datetime.timedelta(seconds=duration_seconds), style='R'), inline=False)
        if ctx.guild:
            delivery_embed.add_field(name="Server", value=ctx.guild.name, inline=False)
        
        try:
            await ctx.author.send(embed=delivery_embed)
        except discord.Forbidden:
            # If DMs are closed, try sending in the original channel (if still accessible)
            try:
                await ctx.send(content=f"Hey {ctx.author.mention}, your reminder:", embed=delivery_embed)
            except discord.HTTPException:
                pass # Channel might be gone or no perms

