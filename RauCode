    def parse_duration(self, duration_str: str) -> int:
        duration_str = duration_str.lower()
        value = int(duration_str[:-1])
        unit = duration_str[-1]
        if unit == 's': return value
        elif unit == 'm': return value * 60
        elif unit == 'h': return value * 60 * 60
        elif unit == 'd': return value * 60 * 60 * 24
        elif unit == 'w': return value * 60 * 60 * 24 * 7
        else: raise ValueError("Invalid duration unit. Use s, m, h, d, w.")

    @commands.command()
    @commands.has_permissions(manage_roles=True) 
    @commands.bot_has_permissions(manage_roles=True)
    async def mute(self, ctx, member: discord.Member, duration_str: str, *, reason: str = "No reason provided"):
        MUTED_ROLE_NAME = "Muted" 
        if member == ctx.author:
            await ctx.send(embed=discord.Embed(title="🚫 Error", description="You cannot mute yourself.", color=discord.Color.red())); return
        if member.top_role >= ctx.author.top_role and ctx.guild.owner != ctx.author:
            await ctx.send(embed=discord.Embed(title="🚫 Error", description="You cannot mute a member with a higher or equal role.", color=discord.Color.red())); return
        if member.top_role >= ctx.guild.me.top_role:
            await ctx.send(embed=discord.Embed(title="🚫 Error", description="I cannot mute a member with a higher or equal role than me.", color=discord.Color.red())); return

        muted_role = discord.utils.get(ctx.guild.roles, name=MUTED_ROLE_NAME)
        if not muted_role:
            await ctx.send(embed=discord.Embed(title="🚫 Error", description=f"The '{MUTED_ROLE_NAME}' role was not found. Please create it.", color=discord.Color.red())); return
        if muted_role in member.roles:
            await ctx.send(embed=discord.Embed(title="⚠️ Already Muted", description=f"{member.display_name} is already muted.", color=discord.Color.orange())); return
        try:
            duration_seconds = self.parse_duration(duration_str)
            if duration_seconds <= 0: raise ValueError("Duration must be positive.")
        except ValueError as e:
            await ctx.send(embed=discord.Embed(title="🚫 Invalid Duration", description=f"Error: {e}. Example: `1h`, `30m`, `1d`.", color=discord.Color.red())); return

        dm_embed = discord.Embed(title="🔇 You Have Been Muted", color=discord.Color.orange())
        dm_embed.add_field(name="Server", value=ctx.guild.name, inline=False)
        dm_embed.add_field(name="Reason", value=reason, inline=False)
        dm_embed.add_field(name="Duration", value=duration_str, inline=False)
        dm_embed.add_field(name="Moderator", value=f"{ctx.author.name}#{ctx.author.discriminator}", inline=False)
        try: await member.send(embed=dm_embed)
        except discord.Forbidden: pass 

        try: await member.add_roles(muted_role, reason=f"Muted by {ctx.author.name} for {reason}")
        except discord.HTTPException as e:
            await ctx.send(embed=discord.Embed(title="🚫 Mute Failed", description=f"An error occurred: {e}", color=discord.Color.red())); return

        s_embed = discord.Embed(title="🔇 User Muted", color=discord.Color.orange(), timestamp=datetime.datetime.utcnow())
        if member.avatar: s_embed.set_thumbnail(url=member.avatar.url)
        s_embed.add_field(name="User", value=f"{member.mention} ({member.id})", inline=False)
        s_embed.add_field(name="Moderator", value=ctx.author.mention, inline=True)
        s_embed.add_field(name="Reason", value=reason, inline=True)
        s_embed.add_field(name="Duration", value=duration_str, inline=False)
        s_embed.set_footer(text=self.create_action_footer(ctx), icon_url=ctx.author.avatar.url if ctx.author.avatar else None)
        await ctx.send(embed=s_embed)

        await asyncio.sleep(duration_seconds)
        try:
            member = await ctx.guild.fetch_member(member.id) 
            if muted_role in member.roles:
                await member.remove_roles(muted_role, reason="Mute duration expired.")
                log_embed = discord.Embed(title="🔊 User Automatically Unmuted", color=discord.Color.green(), timestamp=datetime.datetime.utcnow())
                if member.avatar: log_embed.set_thumbnail(url=member.avatar.url)
                log_embed.add_field(name="User", value=f"{member.mention} ({member.id})", inline=False)
                log_embed.add_field(name="Original Mute Reason", value=reason, inline=True)
                log_embed.add_field(name="Mute Duration", value=duration_str, inline=True)
                await ctx.send(embed=log_embed) 
        except discord.NotFound: pass 
        except discord.HTTPException as e: print(f"Failed to auto-unmute {member.id} in {ctx.guild.id}: {e}")

