    async def cog_command_error(self, ctx, error):
        title = "🤪 Whoopsie! 🤪"
        description = "Something went a bit silly."
        color = discord.Color.random() # Keep it fun!

        if isinstance(error, commands.MissingRequiredArgument):
            title = "🤔 Missing Something?"; description = f"I need `{error.param.name}` to work my magic!"
