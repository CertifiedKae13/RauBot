    @commands.command(aliases=['removewarning', 'delwarn'])
    @commands.has_permissions(kick_members=True)
    async def unwarn(self, ctx, member: discord.Member, warning_id: int):
        gid = ctx.guild.id; uid = member.id
        if not self.user_warnings.get(gid, {}).get(uid):
            await ctx.send(embed=discord.Embed(title="🚫 Unwarn Error", description=f"{member.display_name} has no warnings.", color=discord.Color.red())); return
        
        warn_idx = next((i for i, warn in enumerate(self.user_warnings[gid][uid]) if warn["id"] == warning_id), -1)
        if warn_idx == -1:
            await ctx.send(embed=discord.Embed(title="🚫 Unwarn Error", description=f"Warning ID {warning_id} not found for {member.display_name}.", color=discord.Color.red())); return

        self.user_warnings[gid][uid].pop(warn_idx)
        s_embed = discord.Embed(title="✅ Warning Removed", description=f"Removed warning ID **{warning_id}** for {member.mention}.", color=discord.Color.green(), timestamp=datetime.datetime.utcnow())
        if member.avatar: s_embed.set_thumbnail(url=member.avatar.url)
        s_embed.add_field(name="Moderator", value=ctx.author.mention, inline=False)
        s_embed.set_footer(text=self.create_action_footer(ctx), icon_url=ctx.author.avatar.url if ctx.author.avatar else None)
        await ctx.send(embed=s_embed)

